{
  "schemaVersion": 1,
  "id": "hyperstyle_monumenta",
  "version": "${version}",

  "name": "HyperStyle: Monumenta",
  "description": "Addon for HyperStyle that adds compatibility with the Monumenta server",
  "authors": [
    "Gluucc"
  ],
  "contact": {
    "homepage": "https://github.com/Gluucc/HyperStyle",
    "sources": "https://github.com/Gluucc/HyperStyle"
  },
  "license": "GPL-3.0",
  "icon": "assets/hyperstyle-monumenta/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.gluucc.hyperstyle.monumenta.client.HyperstyleMonumentaClient"
    ],
    "main": [
      "io.github.gluucc.hyperstyle.monumenta.HyperstyleMonumenta"
    ]
  },
  "mixins": [
    "hyperstyle-monumenta.mixins.json"
    ,{
      "config": "hyperstyle-monumenta.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.20.4",
    "hyperstyle": ">=0.1.0-",
    "unofficial-monumenta-mod": ">=1.10"
  }
}